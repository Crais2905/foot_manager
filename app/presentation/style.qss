QWidget {
    background: #f4f7f6;
    color: #182a26;
    font-family: "Segoe UI";
    font-size: 14px;
}
QFrame#sidebar, QLabel#brand, QListWidget#navigation {
    background: #12352f;
    color: #f0f8f5;
    border: none;
}
QLabel#brand {
    padding: 0px 10px 22px;
    font-size: 20px;
    font-weight: 700;
}
QListWidget#navigation { outline: none; }
QListWidget#navigation::item {
    padding: 12px 9px;
    border-radius: 6px;
}
QListWidget#navigation::item:selected { background: #246653; color: white; }
QListWidget#navigation::item:hover:!selected { background: #1c4c40; }
QLabel#heading { font-size: 28px; font-weight: 700; }
QLabel#muted { color: #47645c; }
QLabel#metric { font-size: 29px; font-weight: 700; color: #17694f; }
QFrame#card { background: white; border: 1px solid #d7e4df; border-radius: 10px; }
QFrame#card QLabel { background: transparent; }
QPushButton {
    background: #ffffff;
    border: 1px solid #b8cdc5;
    border-radius: 6px;
    padding: 7px 12px;
    min-height: 18px;
}
QPushButton:hover { background: #e9f5ef; border-color: #38836c; }
QPushButton:default { background: #17694f; border-color: #17694f; color: white; }
QPushButton:disabled { background: #eef2f0; color: #62766e; border-color: #dbe5e0; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus {
    border: 1px solid #248967;
}
QLineEdit, QComboBox, QSpinBox, QDateEdit {
    background: white;
    border: 1px solid #b8cdc5;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 19px;
}
QLineEdit { min-width: 140px; }
QTableView {
    background: white;
    alternate-background-color: #f0f7f3;
    border: 1px solid #d7e4df;
    gridline-color: #e0ebe6;
    selection-background-color: #236b55;
    selection-color: white;
}
QHeaderView::section {
    background: #e1eee8;
    color: #193a30;
    padding: 7px;
    border: 0px;
    font-weight: 600;
}
QLabel#error { background: #fae6e3; color: #8b201a; padding: 8px; border-radius: 6px; }
QLabel#success { background: #def2e8; color: #14513d; padding: 8px; border-radius: 6px; }
QProgressBar { border: none; background: #dceae4; }
QProgressBar::chunk { background: #208461; }
